			<code>129</code>
			<Str sr="arg0" ve="3">// Runs when Do Not Disturb switches off (bedtime mode ended, D25). Moves the event log
// aside, POSTs every pending batch, and deletes each only after a 2xx reply, so a failed
// send is retried next time. Written without less-than or ampersand so it stays plain XML.
var dir = "/sdcard/phdi";
var url = global("PHDI_URL");
var secret = global("PHDI_SECRET");

function run(cmd) {
  try { return shell(cmd, false, 20) || ""; } catch (e) { return ""; }
}

run("mkdir -p " + dir + "/sending");
run("mv " + dir + "/events.csv " + dir + "/sending/" + Date.now() + ".csv");

var names = run("ls " + dir + "/sending").split("\n");
var sent = 0, kept = 0;
for (var i = 0; i != names.length; i++) {
  var name = names[i].trim();
  if (!name) continue;
  var path = dir + "/sending/" + name;
  var xhr = new XMLHttpRequest();
  try {
    xhr.open("POST", url, false);
    xhr.setRequestHeader("Authorization", secret);
    xhr.setRequestHeader("Content-Type", "text/csv");
    xhr.send(readFile(path));
  } catch (e) {}
  if (Math.floor(xhr.status / 100) == 2) { run("rm " + path); sent++; } else { kept++; }
}
if (kept) flash("phdi send: " + sent + " sent, " + kept + " kept for retry (HTTP " + xhr.status + ")");</Str>
			<Str sr="arg1" ve="3"/>
			<Int sr="arg2" val="1"/>
			<Int sr="arg3" val="45"/>
		</Action>
	</Task>
